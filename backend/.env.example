PORT=3000
# DJ local CU13/CU14: no se descarga ningún modelo automáticamente.
OLLAMA_URL=http://127.0.0.1:11434
# Etiqueta EXACTA importada de Liquid AI LFM2.5 1.2B Instruct Q4_K_M (vacío desactiva inferencia).
OLLAMA_MODEL=
OLLAMA_TIMEOUT_MS=45000
OLLAMA_CONTEXT=2048
DATABASE_URL=postgresql://sonic:REEMPLAZAR_POR_UNA_CLAVE_LOCAL@127.0.0.1:5433/sonic_ledger
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
AI_URL=http://127.0.0.1:8010
JWT_SECRET=REEMPLAZAR_POR_UN_SECRETO_ALEATORIO


# Solo desarrollo: escribe correos de prueba en backend/.local/mail; no envía email real.
PASSWORD_RESET_MAIL_MODE=local
PASSWORD_RESET_URL=http://localhost:5173/restablecer-contrasena

# Semillas de demostración en desarrollo local (mínimo 8 caracteres, máx 72 bytes)
# Opcionalmente se pueden configurar DEMO_CLIENTE_PASSWORD, DEMO_ARTISTA_PASSWORD, etc.
DEMO_PASSWORD=REEMPLAZAR_POR_UNA_CONTRASENA_DEMO_LOCAL

# Audius complementario: no requiere clave para lectura pública. Solo servidor.
AUDIUS_BASE_URL=https://api.audius.co/v1
AUDIUS_APP_NAME=SonicLedger
AUDIUS_TIMEOUT_MS=8000
# AUDIUS_API_KEY=

# Pasarela Sandbox de Pagos y Reembolsos (Solo desarrollo y pruebas - No producción)
SANDBOX_GATEWAY_ENABLED=true
SANDBOX_MERCHANT_ID=SONIC_LEDGER_LOCAL_SANDBOX
SANDBOX_API_KEY=REEMPLAZAR_POR_API_KEY_LOCAL
SANDBOX_WEBHOOK_SECRET=REEMPLAZAR_POR_SECRETO_WEBHOOK_LOCAL
