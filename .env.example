# Sonic Ledger usa un archivo .env independiente por servicio.
# Ejecutar: pwsh -File scripts/setup-env.ps1
# Variables reales y ejemplos:
# backend/.env.example  -> backend/.env
# frontend/.env.example -> frontend/.env
# mobile/.env.example   -> mobile/.env
# database/.env.example -> database/.env
# ia/.env.example       -> ia/.env
# Este archivo no configura los servicios al copiarlo a la raíz.
