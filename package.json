{
  "name": "sonic-ledger",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev:backend": "npm --prefix backend run start:dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:mobile": "npm --prefix mobile start",
    "dev:ia": "powershell -ExecutionPolicy Bypass -File scripts/start-ia.ps1",
    "db:up": "docker compose --env-file database/.env -f database/compose.yaml up -d --wait",
    "db:down": "docker compose --env-file database/.env -f database/compose.yaml down",
    "build": "npm --prefix backend run build && npm --prefix frontend run build",
    "check:mobile": "npm --prefix mobile run typecheck",
    "seed": "npm --prefix backend run seed"
  },
  "devDependencies": { "node": "^24.0.0" }
}
